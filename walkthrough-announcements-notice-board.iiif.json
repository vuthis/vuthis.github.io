          "type": "AnnotationPage",
          "items": [
            {
              "id": "https://vuthis.github.io/walkthrough-announcements-notice-board.iiif.json/note/4",
              "type": "Annotation",
              "motivation": "commenting",
              "body": {
                "type": "TextualBody",
                "format": "text/html",
                "language": "en",
                "value": "<h3>Add the subtitle and footer</h3><p>Use the subtitle for the useful detail and the footer for a time, room or next action. For example: Workshop moved to Hall B; Follow signs upstairs.</p><p>The notice has a readable information hierarchy.</p><p><a href=\"https://vuthis.github.io/walkthrough-announcements-notice-board.html#step-4\">Follow this step in Turn a TV into a Digital Notice Board: Interactive Walkthrough</a></p>"
              },
              "target": "https://vuthis.github.io/walkthrough-announcements-notice-board.iiif.json/canvas/2"
            },
            {
              "id": "https://vuthis.github.io/walkthrough-announcements-notice-board.iiif.json/note/5",
              "type": "Annotation",
              "motivation": "commenting",
              "body": {
                "type": "TextualBody",
                "format": "text/html",
                "language": "en",
                "value": "<h3>Choose colours and check the layout</h3><p>Choose readable colours. If your current product access includes an image, add one when it helps explain the notice. Preview how the words fit.</p><p>The important detail stands out.</p><p><a href=\"https://vuthis.github.io/walkthrough-announcements-notice-board.html#step-5\">Follow this step in Turn a TV into a Digital Notice Board: Interactive Walkthrough</a></p>"
              },
              "target": "https://vuthis.github.io/walkthrough-announcements-notice-board.iiif.json/canvas/2"
            },
            {
              "id": "https://vuthis.github.io/walkthrough-announcements-notice-board.iiif.json/note/6",
              "type": "Annotation",
              "motivation": "commenting",
              "body": {
                "type": "TextualBody",
                "format": "text/html",
                "language": "en",
                "value": "<h3>Show the notice and keep it current</h3><p>Choose Show now. Update the announcement from the controller when plans change, then clear or replace it when it no longer applies.</p><p>Visitors see the current announcement.</p><p><a href=\"https://vuthis.github.io/walkthrough-announcements-notice-board.html#step-6\">Follow this step in Turn a TV into a Digital Notice Board: Interactive Walkthrough</a></p>"
              },
              "target": "https://vuthis.github.io/walkthrough-announcements-notice-board.iiif.json/canvas/2"
            }
          ]

      "annotations": [
        {
          "id": "https://vuthis.github.io/walkthrough-pdf-on-tv-projector.iiif.json/notes/1",
          "type": "AnnotationPage",
          "items": [
            {
              "id": "https://vuthis.github.io/walkthrough-pdf-on-tv-projector.iiif.json/note/1",
              "type": "Annotation",
              "motivation": "commenting",
              "body": {
                "type": "TextualBody",
                "format": "text/html",
                "language": "en",
                "value": "<h3>Open vuthis.com on the TV or projector</h3><p>Open vuthis.com in the display browser. For a projector, use its browser or the computer already connected to it. Keep the connection code on screen.</p><p>The screen is ready for a controller.</p><p><a href=\"https://vuthis.github.io/walkthrough-pdf-on-tv-projector.html#step-1\">Follow this step in Show a PDF on TV or a Projector Without HDMI: Interactive Guide</a></p>"
              },
              "target": "https://vuthis.github.io/walkthrough-pdf-on-tv-projector.iiif.json/canvas/1"
            },
            {
              "id": "https://vuthis.github.io/walkthrough-pdf-on-tv-projector.iiif.json/note/2",
              "type": "Annotation",
              "motivation": "commenting",
              "body": {
                "type": "TextualBody",
                "format": "text/html",
                "language": "en",
                "value": "<h3>Connect your phone, tablet or laptop</h3><p>Scan the screen QR code with your phone. On a laptop or tablet, open vuthis.com/r and enter the screen code. Both devices need internet; they can use different networks.</p><p>The content controls are on your device.</p><p><a href=\"https://vuthis.github.io/walkthrough-pdf-on-tv-projector.html#step-2\">Follow this step in Show a PDF on TV or a Projector Without HDMI: Interactive Guide</a></p>"
              },
              "target": "https://vuthis.github.io/walkthrough-pdf-on-tv-projector.iiif.json/canvas/1"
            },
            {
              "id": "https://vuthis.github.io/walkthrough-pdf-on-tv-projector.iiif.json/note/3",
              "type": "Annotation",
              "motivation": "commenting",
              "body": {
                "type": "TextualBody",
                "format": "text/html",
                "language": "en",
                "value": "<h3>Choose Document and select your PDF</h3><p>On the connected controller, choose Document and select the PDF you want to present. Check that it is the intended document.</p><p>The PDF is selected on the controller.</p><p><a href=\"https://vuthis.github.io/walkthrough-pdf-on-tv-projector.html#step-3\">Follow this step in Show a PDF on TV or a Projector Without HDMI: Interactive Guide</a></p>"
              },
              "target": "https://vuthis.github.io/walkthrough-pdf-on-tv-projector.iiif.json/canvas/1"
            }
          ]
        }
      ],

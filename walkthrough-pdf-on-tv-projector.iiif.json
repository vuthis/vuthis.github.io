      "annotations": [
        {
          "id": "https://vuthis.github.io/walkthrough-pdf-on-tv-projector.iiif.json/notes/2",
          "type": "AnnotationPage",
          "items": [
            {
              "id": "https://vuthis.github.io/walkthrough-pdf-on-tv-projector.iiif.json/note/4",
              "type": "Annotation",
              "motivation": "commenting",
              "body": {
                "type": "TextualBody",
                "format": "text/html",
                "language": "en",
                "value": "<h3>Tap Show now to display the PDF</h3><p>Choose Show now. The PDF appears on TV or the projector while its controls remain on your phone or laptop.</p><p>The audience sees the document.</p><p><a href=\"https://vuthis.github.io/walkthrough-pdf-on-tv-projector.html#step-4\">Follow this step in Show a PDF on TV or a Projector Without HDMI: Interactive Guide</a></p>"
              },
              "target": "https://vuthis.github.io/walkthrough-pdf-on-tv-projector.iiif.json/canvas/2"
            },
            {
              "id": "https://vuthis.github.io/walkthrough-pdf-on-tv-projector.iiif.json/note/5",
              "type": "Annotation",
              "motivation": "commenting",
              "body": {
                "type": "TextualBody",
                "format": "text/html",
                "language": "en",
                "value": "<h3>Use Fit page or Fit width</h3><p>Fit page keeps the complete page visible. Fit width enlarges a tall page for reading. Choose the view that makes the important text legible.</p><p>The page is framed for your audience.</p><p><a href=\"https://vuthis.github.io/walkthrough-pdf-on-tv-projector.html#step-5\">Follow this step in Show a PDF on TV or a Projector Without HDMI: Interactive Guide</a></p>"
              },
              "target": "https://vuthis.github.io/walkthrough-pdf-on-tv-projector.iiif.json/canvas/2"
            },
            {
              "id": "https://vuthis.github.io/walkthrough-pdf-on-tv-projector.iiif.json/note/6",
              "type": "Annotation",
              "motivation": "commenting",
              "body": {
                "type": "TextualBody",
                "format": "text/html",
                "language": "en",
                "value": "<h3>Turn pages from your phone or laptop</h3><p>Use Previous and Next. In Fit width, the controls move through a tall page a screenful at a time before changing pages.</p><p>You can present the document at your own pace.</p><p><a href=\"https://vuthis.github.io/walkthrough-pdf-on-tv-projector.html#step-6\">Follow this step in Show a PDF on TV or a Projector Without HDMI: Interactive Guide</a></p>"
              },
              "target": "https://vuthis.github.io/walkthrough-pdf-on-tv-projector.iiif.json/canvas/2"
            }
          ]

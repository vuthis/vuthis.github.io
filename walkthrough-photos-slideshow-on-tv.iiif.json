        {
          "id": "https://vuthis.github.io/walkthrough-photos-slideshow-on-tv.iiif.json/notes/1",
          "type": "AnnotationPage",
          "items": [
            {
              "id": "https://vuthis.github.io/walkthrough-photos-slideshow-on-tv.iiif.json/note/1",
              "type": "Annotation",
              "motivation": "commenting",
              "body": {
                "type": "TextualBody",
                "format": "text/html",
                "language": "en",
                "value": "<h3>Open vuthis.com on the TV or projector</h3><p>Open vuthis.com in the display browser. For a projector, use its browser or the computer already connected to it. Keep the connection code on screen.</p><p>The screen is ready for a controller.</p><p><a href=\"https://vuthis.github.io/walkthrough-photos-slideshow-on-tv.html#step-1\">Follow this step in Show Photos and Run a TV Slideshow Without Casting</a></p>"
              },
              "target": "https://vuthis.github.io/walkthrough-photos-slideshow-on-tv.iiif.json/canvas/1"
            },
            {
              "id": "https://vuthis.github.io/walkthrough-photos-slideshow-on-tv.iiif.json/note/2",
              "type": "Annotation",
              "motivation": "commenting",
              "body": {
                "type": "TextualBody",
                "format": "text/html",
                "language": "en",
                "value": "<h3>Connect your phone, tablet or laptop</h3><p>Scan the screen QR code with your phone. On a laptop or tablet, open vuthis.com/r and enter the screen code. Both devices need internet; they can use different networks.</p><p>The content controls are on your device.</p><p><a href=\"https://vuthis.github.io/walkthrough-photos-slideshow-on-tv.html#step-2\">Follow this step in Show Photos and Run a TV Slideshow Without Casting</a></p>"
              },
              "target": "https://vuthis.github.io/walkthrough-photos-slideshow-on-tv.iiif.json/canvas/1"
            },
            {
              "id": "https://vuthis.github.io/walkthrough-photos-slideshow-on-tv.iiif.json/note/3",
              "type": "Annotation",
              "motivation": "commenting",
              "body": {
                "type": "TextualBody",
                "format": "text/html",
                "language": "en",
                "value": "<h3>Choose Photos and add your pictures</h3><p>Choose Photos and select the images you want everyone to see. Drag the photo list into the intended order before showing it.</p><p>Only the intended photo set is selected.</p><p><a href=\"https://vuthis.github.io/walkthrough-photos-slideshow-on-tv.html#step-3\">Follow this step in Show Photos and Run a TV Slideshow Without Casting</a></p>"
              },
              "target": "https://vuthis.github.io/walkthrough-photos-slideshow-on-tv.iiif.json/canvas/1"
            }
          ]
        }
      ],

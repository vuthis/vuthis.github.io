          "type": "AnnotationPage",
          "items": [
            {
              "id": "https://vuthis.github.io/walkthrough-photos-slideshow-on-tv.iiif.json/note/4",
              "type": "Annotation",
              "motivation": "commenting",
              "body": {
                "type": "TextualBody",
                "format": "text/html",
                "language": "en",
                "value": "<h3>Choose Show now and check the first photo</h3><p>Tap Show now. Use Previous and Next to move through individual pictures from the controller.</p><p>The selected photo appears on TV.</p><p><a href=\"https://vuthis.github.io/walkthrough-photos-slideshow-on-tv.html#step-4\">Follow this step in Show Photos and Run a TV Slideshow Without Casting</a></p>"
              },
              "target": "https://vuthis.github.io/walkthrough-photos-slideshow-on-tv.iiif.json/canvas/2"
            },
            {
              "id": "https://vuthis.github.io/walkthrough-photos-slideshow-on-tv.iiif.json/note/5",
              "type": "Annotation",
              "motivation": "commenting",
              "body": {
                "type": "TextualBody",
                "format": "text/html",
                "language": "en",
                "value": "<h3>Set Slideshow, timing and Start over</h3><p>Turn Slideshow on for automatic advance. Set Seconds per photo and choose Start over when the set should repeat.</p><p>The photos advance at the selected pace.</p><p><a href=\"https://vuthis.github.io/walkthrough-photos-slideshow-on-tv.html#step-5\">Follow this step in Show Photos and Run a TV Slideshow Without Casting</a></p>"
              },
              "target": "https://vuthis.github.io/walkthrough-photos-slideshow-on-tv.iiif.json/canvas/2"
            },
            {
              "id": "https://vuthis.github.io/walkthrough-photos-slideshow-on-tv.iiif.json/note/6",
              "type": "Annotation",
              "motivation": "commenting",
              "body": {
                "type": "TextualBody",
                "format": "text/html",
                "language": "en",
                "value": "<h3>Choose Fit or Fill and control playback</h3><p>Fit keeps the whole image. Fill covers the screen and can crop edges. Pause or Resume the slideshow from your device when the room needs a closer look.</p><p>Your slideshow has the intended framing and pace.</p><p><a href=\"https://vuthis.github.io/walkthrough-photos-slideshow-on-tv.html#step-6\">Follow this step in Show Photos and Run a TV Slideshow Without Casting</a></p>"
              },
              "target": "https://vuthis.github.io/walkthrough-photos-slideshow-on-tv.iiif.json/canvas/2"
            }
          ]

          "type": "AnnotationPage",
          "items": [
            {
              "id": "https://vuthis.github.io/walkthrough-now-serving-tally-counter.iiif.json/note/4",
              "type": "Annotation",
              "motivation": "commenting",
              "body": {
                "type": "TextualBody",
                "format": "text/html",
                "language": "en",
                "value": "<h3>Set the starting value and Step</h3><p>Choose where the count begins. Set Step to the amount added or subtracted by one tap: one for individuals or a larger value for batches.</p><p>Each tap has the intended effect.</p><p><a href=\"https://vuthis.github.io/walkthrough-now-serving-tally-counter.html#step-4\">Follow this step in Display a Now-Serving Number or Tally Counter on TV</a></p>"
              },
              "target": "https://vuthis.github.io/walkthrough-now-serving-tally-counter.iiif.json/canvas/2"
            },
            {
              "id": "https://vuthis.github.io/walkthrough-now-serving-tally-counter.iiif.json/note/5",
              "type": "Annotation",
              "motivation": "commenting",
              "body": {
                "type": "TextualBody",
                "format": "text/html",
                "language": "en",
                "value": "<h3>Choose Show now</h3><p>Show the labelled counter on the TV or projector. Keep the increment, decrement and reset buttons on the controller.</p><p>The room sees one clear current number.</p><p><a href=\"https://vuthis.github.io/walkthrough-now-serving-tally-counter.html#step-5\">Follow this step in Display a Now-Serving Number or Tally Counter on TV</a></p>"
              },
              "target": "https://vuthis.github.io/walkthrough-now-serving-tally-counter.iiif.json/canvas/2"
            },
            {
              "id": "https://vuthis.github.io/walkthrough-now-serving-tally-counter.iiif.json/note/6",
              "type": "Annotation",
              "motivation": "commenting",
              "body": {
                "type": "TextualBody",
                "format": "text/html",
                "language": "en",
                "value": "<h3>Count up, count down or Reset</h3><p>Use + Step or - Step as events happen. Reset returns to your chosen starting value. Check the display before calling the next turn.</p><p>The screen follows the operator count.</p><p><a href=\"https://vuthis.github.io/walkthrough-now-serving-tally-counter.html#step-6\">Follow this step in Display a Now-Serving Number or Tally Counter on TV</a></p>"
              },
              "target": "https://vuthis.github.io/walkthrough-now-serving-tally-counter.iiif.json/canvas/2"
            }
          ]

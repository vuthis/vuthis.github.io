          "id": "https://vuthis.github.io/walkthrough-powerpoint-slides-on-tv.iiif.json/notes/2",
          "type": "AnnotationPage",
          "items": [
            {
              "id": "https://vuthis.github.io/walkthrough-powerpoint-slides-on-tv.iiif.json/note/4",
              "type": "Annotation",
              "motivation": "commenting",
              "body": {
                "type": "TextualBody",
                "format": "text/html",
                "language": "en",
                "value": "<h3>Choose Document, then Show now</h3><p>Select the exported slide PDF in Document and choose Show now. The presentation pages appear on the shared screen.</p><p>The first slide page is on the display.</p><p><a href=\"https://vuthis.github.io/walkthrough-powerpoint-slides-on-tv.html#step-4\">Follow this step in PowerPoint, Google Slides and Keynote on TV Without HDMI</a></p>"
              },
              "target": "https://vuthis.github.io/walkthrough-powerpoint-slides-on-tv.iiif.json/canvas/2"
            },
            {
              "id": "https://vuthis.github.io/walkthrough-powerpoint-slides-on-tv.iiif.json/note/5",
              "type": "Annotation",
              "motivation": "commenting",
              "body": {
                "type": "TextualBody",
                "format": "text/html",
                "language": "en",
                "value": "<h3>Choose Fit page for complete slides</h3><p>Use Fit page so the entire slide is visible. A landscape presentation usually suits a widescreen TV or projector.</p><p>The whole slide is visible.</p><p><a href=\"https://vuthis.github.io/walkthrough-powerpoint-slides-on-tv.html#step-5\">Follow this step in PowerPoint, Google Slides and Keynote on TV Without HDMI</a></p>"
              },
              "target": "https://vuthis.github.io/walkthrough-powerpoint-slides-on-tv.iiif.json/canvas/2"
            },
            {
              "id": "https://vuthis.github.io/walkthrough-powerpoint-slides-on-tv.iiif.json/note/6",
              "type": "Annotation",
              "motivation": "commenting",
              "body": {
                "type": "TextualBody",
                "format": "text/html",
                "language": "en",
                "value": "<h3>Advance the slide pages as you present</h3><p>Use Previous and Next on the controller. Keep notes and other device activity on your laptop or phone while the room sees the selected PDF.</p><p>The presentation moves at your pace.</p><p><a href=\"https://vuthis.github.io/walkthrough-powerpoint-slides-on-tv.html#step-6\">Follow this step in PowerPoint, Google Slides and Keynote on TV Without HDMI</a></p>"
              },

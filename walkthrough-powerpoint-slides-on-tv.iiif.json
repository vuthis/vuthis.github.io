          "type": "AnnotationPage",
          "items": [
            {
              "id": "https://vuthis.github.io/walkthrough-powerpoint-slides-on-tv.iiif.json/note/1",
              "type": "Annotation",
              "motivation": "commenting",
              "body": {
                "type": "TextualBody",
                "format": "text/html",
                "language": "en",
                "value": "<h3>Open vuthis.com on the TV or projector</h3><p>Open vuthis.com in the display browser. For a projector, use its browser or the computer already connected to it. Keep the connection code on screen.</p><p>The screen is ready for a controller.</p><p><a href=\"https://vuthis.github.io/walkthrough-powerpoint-slides-on-tv.html#step-1\">Follow this step in PowerPoint, Google Slides and Keynote on TV Without HDMI</a></p>"
              },
              "target": "https://vuthis.github.io/walkthrough-powerpoint-slides-on-tv.iiif.json/canvas/1"
            },
            {
              "id": "https://vuthis.github.io/walkthrough-powerpoint-slides-on-tv.iiif.json/note/2",
              "type": "Annotation",
              "motivation": "commenting",
              "body": {
                "type": "TextualBody",
                "format": "text/html",
                "language": "en",
                "value": "<h3>Connect your phone, tablet or laptop</h3><p>Scan the screen QR code with your phone. On a laptop or tablet, open vuthis.com/r and enter the screen code. Both devices need internet; they can use different networks.</p><p>The content controls are on your device.</p><p><a href=\"https://vuthis.github.io/walkthrough-powerpoint-slides-on-tv.html#step-2\">Follow this step in PowerPoint, Google Slides and Keynote on TV Without HDMI</a></p>"
              },
              "target": "https://vuthis.github.io/walkthrough-powerpoint-slides-on-tv.iiif.json/canvas/1"
            },
            {
              "id": "https://vuthis.github.io/walkthrough-powerpoint-slides-on-tv.iiif.json/note/3",
              "type": "Annotation",
              "motivation": "commenting",
              "body": {
                "type": "TextualBody",
                "format": "text/html",
                "language": "en",
                "value": "<h3>Export your presentation as PDF</h3><p>In PowerPoint, Google Slides, Keynote or Canva, export or download the presentation as PDF. Check the exported page order and layout.</p><p>Your presentation is ready as a PDF.</p><p><a href=\"https://vuthis.github.io/walkthrough-powerpoint-slides-on-tv.html#step-3\">Follow this step in PowerPoint, Google Slides and Keynote on TV Without HDMI</a></p>"
              },
              "target": "https://vuthis.github.io/walkthrough-powerpoint-slides-on-tv.iiif.json/canvas/1"
            }
          ]
        }
      ],

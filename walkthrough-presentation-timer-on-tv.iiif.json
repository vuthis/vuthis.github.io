      "annotations": [
        {
          "id": "https://vuthis.github.io/walkthrough-presentation-timer-on-tv.iiif.json/notes/2",
          "type": "AnnotationPage",
          "items": [
            {
              "id": "https://vuthis.github.io/walkthrough-presentation-timer-on-tv.iiif.json/note/4",
              "type": "Annotation",
              "motivation": "commenting",
              "body": {
                "type": "TextualBody",
                "format": "text/html",
                "language": "en",
                "value": "<h3>Set the duration or target and label</h3><p>Enter the duration or finishing time. Add a label such as Break, Questions, Presentation time or Group work. Choose readable colours.</p><p>The room knows what the time refers to.</p><p><a href=\"https://vuthis.github.io/walkthrough-presentation-timer-on-tv.html#step-4\">Follow this step in Countdown, Count-Up and Presentation Timer on TV</a></p>"
              },
              "target": "https://vuthis.github.io/walkthrough-presentation-timer-on-tv.iiif.json/canvas/2"
            },
            {
              "id": "https://vuthis.github.io/walkthrough-presentation-timer-on-tv.iiif.json/note/5",
              "type": "Annotation",
              "motivation": "commenting",
              "body": {
                "type": "TextualBody",
                "format": "text/html",
                "language": "en",
                "value": "<h3>Choose Show now and run the timer</h3><p>Show the timer on the shared display. The audience sees the large timer while the controller keeps its buttons.</p><p>The room can follow the time.</p><p><a href=\"https://vuthis.github.io/walkthrough-presentation-timer-on-tv.html#step-5\">Follow this step in Countdown, Count-Up and Presentation Timer on TV</a></p>"
              },
              "target": "https://vuthis.github.io/walkthrough-presentation-timer-on-tv.iiif.json/canvas/2"
            },
            {
              "id": "https://vuthis.github.io/walkthrough-presentation-timer-on-tv.iiif.json/note/6",
              "type": "Annotation",
              "motivation": "commenting",
              "body": {
                "type": "TextualBody",
                "format": "text/html",
                "language": "en",
                "value": "<h3>Pause, resume or restart the appropriate mode</h3><p>Down and Up support Pause, Resume and Restart. To a time stays tied to the fixed target. At the end of a countdown, the timer and background colours swap.</p><p>The timer follows the event rather than distracting from it.</p><p><a href=\"https://vuthis.github.io/walkthrough-presentation-timer-on-tv.html#step-6\">Follow this step in Countdown, Count-Up and Presentation Timer on TV</a></p>"
              },
              "target": "https://vuthis.github.io/walkthrough-presentation-timer-on-tv.iiif.json/canvas/2"
            }
          ]
        }
